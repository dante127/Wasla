# Wasla — local development environment
# Copy this file to `.env` and fill in local values. NEVER commit real secrets.

# Docker compose: PostgreSQL password (compose default: wasla_dev)
# Host ports: postgres is exposed on 5433 (5432 may be taken by a local PostgreSQL install); redis on 6379.
POSTGRES_PASSWORD=

# Docker compose: MinIO root credentials (optional storage profile)
# MINIO_ROOT_USER=
# MINIO_ROOT_PASSWORD=

# Application configuration overrides.
# The WASLA_ prefix maps to configuration sections (double underscore = nesting).
# Examples:
#   WASLA_Database__ConnectionString=Host=localhost;Port=5433;Database=wasla;Username=wasla;Password=<local-password>
#   WASLA_Redis__ConnectionString=localhost:6379
#   WASLA_Telemetry__OtlpEndpoint=http://localhost:4317
WASLA_Database__ConnectionString=
WASLA_Redis__ConnectionString=
WASLA_Telemetry__OtlpEndpoint=
