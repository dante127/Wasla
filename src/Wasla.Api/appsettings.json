{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "System": "Warning"
      }
    }
  },
  "AllowedHosts": "*",
  "Database": {
    "ConnectionString": ""
  },
  "Redis": {
    "ConnectionString": ""
  },
  "Telemetry": {
    "ServiceName": "wasla-api",
    "OtlpEndpoint": null
  },
  "Jwt": {
    "Issuer": "wasla",
    "Audience": "wasla-api",
    "SigningKey": "",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 30
  },
  "Seed": {
    "Password": ""
  },
  "Security": {
    "EncryptionKey": ""
  },
  "WhatsApp": {
    "BaseUrl": "https://graph.facebook.com",
    "ApiVersion": "v21.0",
    "TimeoutSeconds": 30,
    "SkipConnectVerification": false
  },
  "Workers": {
    "InboxEnabled": true,
    "OutboxEnabled": true,
    "PollIntervalSeconds": 2,
    "BatchSize": 20,
    "MaxAttempts": 8
  },
  "Cors": {
    "AllowedOrigins": []
  }
}
